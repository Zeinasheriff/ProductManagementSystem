@inherits LayoutComponentBase
@using ProductManagement.Blazor.Shared

<div class="app-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <div class="main-area">
        <header class="topbar px-4">
            <div class="topbar-left">
                <span class="brand-mobile"><i class="bi bi-box-seam-fill"></i>ProductHub</span>
                <AuthorizeView>
                    <Authorized>
                        <span class="topbar-greeting"><i class="bi bi-emoji-smile"></i>Welcome back,&nbsp;<strong>@greeting</strong></span>
                    </Authorized>
                </AuthorizeView>
            </div>
            <div class="topbar-actions">
                <AuthorizeView>
                    <Authorized>
                        <span class="avatar" title="@greeting">@initials</span>
                        <a class="btn btn-sm btn-outline-secondary" href="/profile"><i class="bi bi-person me-1"></i>Profile</a>
                        <a class="btn btn-sm btn-logout" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-sm btn-primary" href="/login"><i class="bi bi-box-arrow-in-right me-1"></i>Login</a>
                        <a class="btn btn-sm btn-outline-secondary" href="/register">Register</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="page-content">
            @Body
        </main>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string greeting = "there";
    private string initials = "?";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null) return;

        var authState = await AuthStateTask;
        var user = authState.User;
        var name = UserDisplay.GetDisplayName(user);

        if (!string.IsNullOrWhiteSpace(name))
        {
            greeting = name;
            initials = UserDisplay.GetInitials(user);
        }
    }
}