@using ProductManagement.Blazor.Shared
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated == true)
                    {
                        <div class="empty-state mt-4">
                            <div class="empty-icon danger"><i class="bi bi-shield-lock"></i></div>
                            <h4>Access Denied</h4>
                            <p>You do not have permission to view this page.</p>
                            <a class="btn btn-primary" href="/"><i class="bi bi-arrow-left me-1"></i>Back to Home</a>
                        </div>
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="loading-wrap">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Checking access...</span>
                        </div>
                        <p class="mt-3 text-muted">Checking access...</p>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="empty-state mt-4">
                    <div class="empty-icon"><i class="bi bi-compass"></i></div>
                    <h4>Page not found</h4>
                    <p role="alert">Sorry, there's nothing at this address.</p>
                    <a class="btn btn-primary" href="/"><i class="bi bi-arrow-left me-1"></i>Back to Home</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
