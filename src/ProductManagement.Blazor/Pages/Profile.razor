@page "/profile"
@using ProductManagement.Blazor.Shared
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<PageTitle>My Profile · ProductHub</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <span class="profile-avatar mb-3">@initials</span>
                            <h4 class="fw-bold text-dark mb-1">@displayName</h4>
                            <span class="@roleBadgeClass">@roleLabel</span>
                        </div>

                        <dl class="mb-0 px-2">
                            <div class="info-row">
                                <i class="bi bi-person"></i>
                                <dt>Full Name</dt>
                                <dd class="ms-auto">@displayName</dd>
                            </div>
                            <div class="info-row">
                                <i class="bi bi-envelope"></i>
                                <dt>Email</dt>
                                <dd class="ms-auto">@email</dd>
                            </div>
                            <div class="info-row">
                                <i class="bi bi-shield-check"></i>
                                <dt>Role</dt>
                                <dd class="ms-auto">@roleLabel</dd>
                            </div>
                        </dl>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="/orders" class="btn btn-outline-primary"><i class="bi bi-receipt me-1"></i>My Orders</a>
                            <a href="/logout" class="btn btn-outline-danger"><i class="bi bi-box-arrow-right me-1"></i>Sign Out</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-person-lock"></i></div>
            <h4>You're not signed in</h4>
            <p>Please log in to view your profile.</p>
            <div class="d-flex gap-2 justify-content-center">
                <a href="/login" class="btn btn-primary">Log in</a>
                <a href="/register" class="btn btn-outline-secondary">Register</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Inject] private AuthenticationStateProvider InjectedAuthStateProvider { get; set; } = default!;

    private string displayName = string.Empty;
    private string email = string.Empty;
    private bool isAdmin;
    private string initials = "?";
    private string roleLabel = "User";
    private string roleBadgeClass = "badge pill-info";

    protected override async Task OnInitializedAsync()
    {
        var authState = await InjectedAuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            displayName = UserDisplay.GetDisplayName(user);
            initials = UserDisplay.GetInitials(user);
            email = user.FindFirst(ClaimTypes.Email)?.Value ?? string.Empty;
            isAdmin = user.IsInRole("Admin");
            roleLabel = isAdmin ? "Admin" : "User";
            roleBadgeClass = isAdmin ? "badge pill-out" : "badge pill-info";
        }
    }
}