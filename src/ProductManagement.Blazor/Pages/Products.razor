@page "/products"
@inject IProductClientService ProductService

<PageTitle>Products · ProductHub</PageTitle>

<div class="page-header">
    <div>
        <h1>Product Catalog</h1>
        <p>Browse the catalog and check live stock levels.</p>
    </div>
    <AuthorizeView Roles="Admin">
        <Authorized>
            <a href="/products/create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Product</a>
        </Authorized>
    </AuthorizeView>
</div>

<div class="toolbar">
    <div class="search-box input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" placeholder="Search by name…" @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleSearch" />
    </div>
    @if (!loading && pagedResult != null && pagedResult.TotalCount > 0)
    {
        <span class="text-muted" style="font-size:.85rem;">@pagedResult!.TotalCount result(s)</span>
    }
</div>

@if (loading)
{
    <div class="card"><div class="loading-wrap"><div class="spinner-border text-primary"></div><p class="mt-3 mb-0">Loading products…</p></div></div>
}
else if (pagedResult == null || !pagedResult.Items.Any())
{
    <div class="empty-state">
        <div class="empty-icon"><i class="bi bi-inbox"></i></div>
        <h4>No products found</h4>
        <p>@(string.IsNullOrWhiteSpace(searchQuery) ? "The catalog is empty." : $"Nothing matches \"{searchQuery}\".")</p>
    </div>
}
else
{
    <div class="card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-modern align-middle">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in pagedResult.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold text-dark">@p.Name</div>
                                @if (!string.IsNullOrWhiteSpace(p.Description))
                                {
                                    <div class="text-muted small text-truncate" style="max-width:340px;" title="@p.Description">@p.Description</div>
                                }
                            </td>
                            <td class="fw-semibold">@p.Price.ToString("C")</td>
                            <td>@GetStockBadge(p)</td>
                            <td><span class="badge @(p.IsActive ? "pill-active" : "pill-inactive")">@(p.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-end">
                                <AuthorizeView Roles="Admin">
                                    <Authorized>
                                        <a href="/products/edit/@p.Id" class="btn btn-sm btn-outline-secondary me-1" title="Edit"><i class="bi bi-pencil"></i></a>
                                        @if (p.IsActive)
                                        {
                                            if (pendingDeactivateId == p.Id)
                                            {
                                                <button class="btn btn-sm btn-danger me-1" @onclick="() => DeactivateProduct(p.Id)"><i class="bi bi-check-lg me-1"></i>Confirm</button>
                                                <button class="btn btn-sm btn-outline-secondary" title="Cancel" @onclick="CancelDeactivate"><i class="bi bi-x-lg"></i></button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-danger" title="Deactivate" @onclick="() => pendingDeactivateId = p.Id"><i class="bi bi-archive"></i></button>
                                            }
                                        }
                                    </Authorized>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
        <span class="text-muted" style="font-size:.85rem;">Page @pagedResult.PageNumber of @(pagedResult.TotalPages == 0 ? 1 : pagedResult.TotalPages)</span>
        <div class="d-flex gap-2">
            <button class="page-btn" disabled="@(!pagedResult.HasPreviousPage)" @onclick="PreviousPage"><i class="bi bi-chevron-left"></i> Previous</button>
            <button class="page-btn" disabled="@(!pagedResult.HasNextPage)" @onclick="NextPage">Next <i class="bi bi-chevron-right"></i></button>
        </div>
    </div>
}

@code {
    private PagedResult<ProductDto>? pagedResult;
    private string searchQuery = string.Empty;
    private int currentPage = 1;
    private bool loading = true;
    private int? pendingDeactivateId;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        loading = true;
        try
        {
            pagedResult = await ProductService.SearchProducts(searchQuery, currentPage, 10);
        }
        finally
        {
            loading = false;
        }

        // Keep the page cursor valid after filtering shrinks the result set.
        if (pagedResult is { TotalCount: > 0 } && currentPage > pagedResult.TotalPages)
        {
            currentPage = pagedResult.TotalPages;
            await LoadProducts();
        }
    }

    private async Task HandleSearch()
    {
        currentPage = 1;
        await LoadProducts();
    }

    private async Task PreviousPage()
    {
        if (pagedResult?.HasPreviousPage == true)
        {
            currentPage--;
            await LoadProducts();
        }
    }

    private async Task NextPage()
    {
        if (pagedResult?.HasNextPage == true)
        {
            currentPage++;
            await LoadProducts();
        }
    }

    private void CancelDeactivate() => pendingDeactivateId = null;

    private async Task DeactivateProduct(int id)
    {
        var result = await ProductService.Deactivate(id);
        pendingDeactivateId = null;
        if (result.Success)
        {
            await LoadProducts();
        }
    }

    private static MarkupString GetStockBadge(ProductDto p)
    {
        if (p.StockQuantity <= 0)
        {
            return new MarkupString("<span class=\"badge pill-out\">Out of stock</span>");
        }
        if (p.StockQuantity <= 10)
        {
            return new MarkupString($"<span class=\"badge pill-low\">Low · {p.StockQuantity}</span>");
        }
        return new MarkupString($"<span class=\"badge pill-active\">{p.StockQuantity} in stock</span>");
    }
}