@page "/orders/create"
@attribute [Authorize]
@inject IProductClientService ProductService
@inject IOrderClientService OrderService
@inject NavigationManager NavManager

<PageTitle>Create Order · ProductHub</PageTitle>

<div class="page-header">
    <div>
        <h1>Create Order</h1>
        <p>Pick products, adjust quantities and place your order.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@errorMessage</span>
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <h5 class="fw-bold text-dark mb-3">Available Products</h5>

        @if (products == null)
        {
            <div class="card"><div class="loading-wrap"><div class="spinner-border text-primary"></div><p class="mt-3 mb-0">Loading catalog…</p></div></div>
        }
        else
        {
            var available = products.Items.Where(x => x.IsActive && x.StockQuantity > 0).ToList();

            if (available.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="bi bi-inbox"></i></div>
                    <h4>Nothing in stock right now</h4>
                    <p>There are no active products available to order.</p>
                    <a href="/products" class="btn btn-outline-primary">Back to catalog</a>
                </div>
            }
            else
            {
                @foreach (var p in available)
                {
                    <div class="pick-card">
                        <div>
                            <div class="pick-name">@p.Name</div>
                            <div class="pick-meta">
                                <strong>@p.Price.ToString("C")</strong> · @p.StockQuantity in stock
                            </div>
                        </div>
                        <button class="btn btn-sm btn-primary flex-shrink-0" @onclick="() => AddToCart(p)">
                            <i class="bi bi-plus-lg me-1"></i>Add
                        </button>
                    </div>
                }
            }
        }
    </div>

    <div class="col-lg-5">
        <div class="card sticky-top" style="top: 84px;">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-cart3 text-primary"></i> Order Summary
            </div>
            <div class="card-body">
                @if (!cart.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-cart-x fs-1 d-block mb-2"></i>
                        Your cart is empty.<br />Add products to get started.
                    </div>
                }
                else
                {
                    @foreach (var item in cart)
                    {
                        <div class="d-flex justify-content-between align-items-center border-bottom py-2 gap-2">
                            <div class="min-w-0">
                                <div class="pick-name text-truncate">@item.ProductName</div>
                                <div class="pick-meta">@item.UnitPrice.ToString("C") each</div>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                <div class="qty-stepper">
                                    <button title="Decrease" @onclick="() => ChangeQty(item, -1)">−</button>
                                    <input type="number" min="1" max="@item.MaxStock" value="@item.Quantity" @onchange="e => SetQty(item, e.Value?.ToString())" />
                                    <button title="Increase" @onclick="() => ChangeQty(item, 1)">+</button>
                                </div>
                                <span class="fw-semibold">@((item.UnitPrice * item.Quantity).ToString("C"))</span>
                                <button class="btn btn-sm btn-outline-danger" title="Remove" @onclick="() => RemoveFromCart(item)"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="text-muted">Estimated Total</span>
                        <span class="summary-total">@estimatedTotal.ToString("C")</span>
                    </div>

                    <button class="btn btn-success w-100 mt-3" @onclick="SubmitOrder" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span><text>Processing…</text>
                        }
                        else
                        {
                            <text><i class="bi bi-bag-check me-1"></i>Place Order</text>
                        }
                    </button>
                    <div class="text-center mt-2 text-muted" style="font-size:.8rem;">
                        Stock and totals are validated server-side on submit.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private PagedResult<ProductDto>? products;
    private List<CartItem> cart = new();
    private decimal estimatedTotal = 0m;
    private string errorMessage = string.Empty;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        products = await ProductService.SearchProducts("", 1, 100);
    }

    private void AddToCart(ProductDto product)
    {
        errorMessage = string.Empty;

        var existing = cart.FirstOrDefault(c => c.ProductId == product.Id);
        if (existing == null)
        {
            if (product.StockQuantity > 0)
            {
                cart.Add(new CartItem
                {
                    ProductId = product.Id,
                    ProductName = product.Name,
                    UnitPrice = product.Price,
                    MaxStock = product.StockQuantity,
                    Quantity = 1
                });
            }
        }
        else if (existing.Quantity < existing.MaxStock)
        {
            existing.Quantity++;
        }

        CalculateTotal();
    }

    private void ChangeQty(CartItem item, int delta)
    {
        item.Quantity = Math.Clamp(item.Quantity + delta, 1, Math.Max(1, item.MaxStock));
        CalculateTotal();
    }

    private void SetQty(CartItem item, string? rawValue)
    {
        if (!int.TryParse(rawValue, out var qty))
        {
            qty = 1;
        }
        item.Quantity = Math.Clamp(qty, 1, Math.Max(1, item.MaxStock));
        CalculateTotal();
    }

    private void RemoveFromCart(CartItem item)
    {
        cart.Remove(item);
        CalculateTotal();
    }

    private void CalculateTotal()
    {
        estimatedTotal = cart.Sum(i => i.UnitPrice * i.Quantity);
    }

    private async Task SubmitOrder()
    {
        if (!cart.Any())
        {
            return;
        }

        errorMessage = string.Empty;
        isSubmitting = true;

        try
        {
            var request = new CreateOrderRequest(
                cart.Select(c => new CreateOrderItemRequest(c.ProductId, c.Quantity)).ToList());

            var (order, error) = await OrderService.CreateOrder(request);

            if (order != null)
            {
                NavManager.NavigateTo("/orders");
            }
            else
            {
                // Surface the server-side business error (e.g. insufficient stock).
                errorMessage = string.IsNullOrWhiteSpace(error)
                    ? "Order submission failed. Please check stock availability and try again."
                    : error;
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private class CartItem
    {
        public int ProductId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public decimal UnitPrice { get; set; }
        public int MaxStock { get; set; }
        public int Quantity { get; set; }
    }
}