@page "/dashboard"
@attribute [Authorize]
@using ProductManagement.Blazor.Shared
@inject IProductClientService ProductService
@inject IOrderClientService OrderService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Dashboard · ProductHub</PageTitle>

<div class="hero mb-4">
    <h1>Welcome back, @displayName!</h1>
    <p>Manage your catalog, place orders and keep an eye on stock levels - all from one place.</p>
    <div class="d-flex gap-2 flex-wrap">
        <a href="/orders/create" class="btn btn-light"><i class="bi bi-cart-plus me-1"></i>Create Order</a>
        <a href="/products" class="btn btn-light-ghost"><i class="bi bi-box-seam me-1"></i>Browse Products</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card stat-card">
            <span class="stat-icon"><i class="bi bi-box-seam"></i></span>
            <div>
                <div class="stat-value">@(loadingStats ? "…" : productCount.ToString("N0"))</div>
                <div class="stat-label">Products in catalog</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card">
            <span class="stat-icon green"><i class="bi bi-receipt"></i></span>
            <div>
                <div class="stat-value">@(loadingStats ? "…" : orderCount.ToString("N0"))</div>
                <div class="stat-label">Orders placed</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card">
            <span class="stat-icon amber"><i class="bi bi-cash-stack"></i></span>
            <div>
                <div class="stat-value">@(loadingStats ? "…" : totalSpent.ToString("C"))</div>
                <div class="stat-label">Total spent</div>
            </div>
        </div>
    </div>
</div>

<h5 class="fw-bold text-dark mb-3">Quick actions</h5>
<div class="row g-3">
    <div class="col-md-4">
        <a href="/products" class="card quick-card text-decoration-none">
            <h5><i class="bi bi-search fs-5"></i> Browse Catalog</h5>
            <p class="text-muted mb-0">Search products by name and check live stock levels.</p>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/orders/create" class="card quick-card text-decoration-none">
            <h5><i class="bi bi-cart-plus fs-5"></i> Create Order</h5>
            <p class="text-muted mb-0">Place an order - stock is validated automatically server-side.</p>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/orders" class="card quick-card text-decoration-none">
            <h5><i class="bi bi-receipt fs-5"></i> My Orders</h5>
            <p class="text-muted mb-0">Review order history, line items and totals.</p>
        </a>
    </div>
</div>

@code {
    private int productCount;
    private int orderCount;
    private decimal totalSpent;
    private bool loadingStats = true;
    private string displayName = "there";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var name = UserDisplay.GetDisplayName(authState.User);
        if (!string.IsNullOrWhiteSpace(name))
        {
            displayName = name;
        }

        var products = await ProductService.SearchProducts("", 1, 1);
        productCount = products?.TotalCount ?? 0;

        var orders = await OrderService.GetMyOrders();
        orderCount = orders?.Count ?? 0;
        totalSpent = orders?.Sum(o => o.TotalAmount) ?? 0m;

        loadingStats = false;
    }
}
