@page "/orders"
@attribute [Authorize]
@inject IOrderClientService OrderService

<PageTitle>My Orders · ProductHub</PageTitle>

<div class="page-header">
    <div>
        <h1>My Orders</h1>
        <p>Your complete order history.</p>
    </div>
    <a href="/orders/create" class="btn btn-primary"><i class="bi bi-cart-plus me-1"></i>New Order</a>
</div>

@if (loading)
{
    <div class="card"><div class="loading-wrap"><div class="spinner-border text-primary"></div><p class="mt-3 mb-0">Loading orders…</p></div></div>
}
else if (orders == null || !orders.Any())
{
    <div class="empty-state">
        <div class="empty-icon"><i class="bi bi-receipt-cutoff"></i></div>
        <h4>No orders yet</h4>
        <p>When you place an order it will show up here with its line items and total.</p>
        <a href="/orders/create" class="btn btn-primary"><i class="bi bi-cart-plus me-1"></i>Create your first order</a>
    </div>
}
else
{
    var totalCount = orders.Count;
    var totalSpent = orders.Sum(o => o.TotalAmount);

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card stat-card">
                <span class="stat-icon green"><i class="bi bi-receipt"></i></span>
                <div>
                    <div class="stat-value">@totalCount.ToString("N0")</div>
                    <div class="stat-label">Orders placed</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card stat-card">
                <span class="stat-icon amber"><i class="bi bi-cash-stack"></i></span>
                <div>
                    <div class="stat-value">@totalSpent.ToString("C")</div>
                    <div class="stat-label">Total spent</div>
                </div>
            </div>
        </div>
    </div>

    @foreach (var order in orders)
    {
        <div class="card mb-3 overflow-hidden">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-receipt text-primary"></i>
                    <strong>Order #@order.Id</strong>
                    <span class="text-muted" style="font-size:.85rem;">· @order.OrderDate.ToLocalTime().ToString("g")</span>
                </div>
                <span class="@GetStatusBadgeClass(order.Status)">@order.Status</span>
            </div>
            <div class="table-responsive">
                <table class="table table-modern mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td class="text-end">@item.UnitPrice.ToString("C")</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.TotalPrice.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end fw-bold" style="border-top:1px solid var(--pm-border);">Total</td>
                            <td class="text-end fw-bold text-success" style="border-top:1px solid var(--pm-border);">@order.TotalAmount.ToString("C")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
}

@code {
    private List<OrderDto>? orders;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            orders = await OrderService.GetMyOrders();
        }
        finally
        {
            loading = false;
        }
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Completed" => "badge pill-active",
        "Cancelled" => "badge pill-out",
        "Pending" => "badge pill-low",
        _ => "badge pill-info"
    };
}