@page "/orders"
@attribute [Authorize]
@inject IOrderClientService OrderService

<PageTitle>My Orders</PageTitle>

<h3>My Orders</h3>

@if (loading)
{
    <p><em>Loading orders...</em></p>
}
else if (orders == null || !orders.Any())
{
    <div class="alert alert-info">
        You have no orders yet. <a href="/orders/create">Create your first order</a>.
    </div>
}
else
{
    <div class="mb-3">
        <a href="/orders/create" class="btn btn-primary">Create New Order</a>
    </div>

    @foreach (var order in orders)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Order #@order.Id</strong>
                <span class="badge @(order.Status == "Completed" ? "bg-success" : "bg-warning")">@order.Status</span>
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-md-6">
                        <strong>Date:</strong> @order.OrderDate.ToLocalTime().ToString("g")
                    </div>
                    <div class="col-md-6 text-end">
                        <strong>Total:</strong> <span class="text-success fw-bold">@order.TotalAmount.ToString("C")</span>
                    </div>
                </div>

                <table class="table table-sm table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td class="text-end">@item.UnitPrice.ToString("C")</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.TotalPrice.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private List<OrderDto>? orders;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        orders = await OrderService.GetMyOrders();
        loading = false;
    }
}